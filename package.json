{
  "name": "devdeck",
  "version": "2.0.0",
  "private": true,
  "description": "DevDeck: local dashboard for Claude Code token usage and git repo management",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node server/index.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.js",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "bash scripts/release.sh",
    "desktop:dev": "concurrently -k -n web,app -c green,blue \"vite --strictPort\" \"wait-on tcp:5173 && cross-env DEVDECK_DEV_URL=http://localhost:5173 electron .\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^9.5.1"
  },
  "main": "electron/main.cjs",
  "author": "HoaiNam071001",
  "build": {
    "appId": "com.hoainam.devdeck",
    "productName": "DevDeck",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "server/jobs/*.ps1"
    ],
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DevDeck-${version}-setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HoaiNam071001",
        "repo": "dev-deck"
      }
    ],
    "portable": {
      "artifactName": "DevDeck-${version}-portable.exe"
    }
  }
}
